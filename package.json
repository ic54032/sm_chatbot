{
  "name": "salon-receptionist",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "migrate:up": "tsx src/db/migrate.ts up",
    "migrate:up:prod": "node dist/db/migrate.js up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "lint": "tsc --noEmit",
    "encrypt-pits": "tsx scripts/encrypt-existing-pits.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@google/genai": "^2.0.1",
    "bullmq": "^5.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "ioredis": "^5.3.2",
    "kysely": "^0.27.0",
    "openai": "^4.104.0",
    "pg": "^8.11.0",
    "pino": "^9.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.0",
    "fast-check": "^3.15.0",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
